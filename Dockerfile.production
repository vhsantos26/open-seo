# Production self-host image: builds the app at IMAGE-build time (in CI), not at
# container start. This keeps the ~4 GiB SSR build off the deployment host — it
# runs on the CI runner instead — so a memory-constrained box never risks OOM
# during a boot build.
#
# It reuses docker-entrypoint.sh unmodified. That entrypoint rebuilds only when
# the build-relevant env fingerprint changes; we pre-compute and ship that
# fingerprint below, so at runtime it finds a valid build and skips straight to
# preflight -> migrations -> serve. The runtime container MUST set the same
# build-relevant env this image baked in (AUTH_MODE=local_noauth,
# VITE_SHOW_DEVTOOLS=false, POSTHOG_* unset) or the entrypoint will rebuild.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Fixed self-host build-time env. These get inlined into the client bundle
# (see envPrefix in vite.config.ts), so they are baked, not runtime-tunable.
ENV AUTH_MODE=local_noauth
ENV VITE_SHOW_DEVTOOLS=false

# Build once here, then write the exact fingerprint docker-entrypoint.sh checks
# (keep this expression in sync with the FINGERPRINT line in that script). The
# .npmrc already raises the V8 heap so the SSR build does not OOM on the runner.
RUN pnpm run build \
  && FINGERPRINT="$(env | grep -E '^(VITE_|AUTH_MODE|BYPASS_EMAIL_VERIFICATION|POSTHOG_PUBLIC_KEY|POSTHOG_HOST|TURNSTILE_SITE_KEY|POSTHOG_SOURCEMAPS)' | sort | sha256sum | cut -d' ' -f1)" \
  && test -n "$FINGERPRINT" \
  && printf '%s' "$FINGERPRINT" > dist/.openseo-build-env

EXPOSE 3001

# Same readiness probe as Dockerfile.selfhost, but with a short start period:
# this image ships a valid build, so startup is only preflight + migrations.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["sh", "docker-entrypoint.sh"]
